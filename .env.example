# ──────────────────────────────────────────────────────────────
#  Portal IA Mirante — variáveis de ambiente
#  Copie este arquivo para .env e preencha com suas credenciais.
# ──────────────────────────────────────────────────────────────

# Firebase — obtenha em: Firebase Console → Configurações do Projeto → Seus apps → SDK Config
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# EmailJS — envio de e-mails client-side sem backend
# Setup: https://www.emailjs.com → crie conta → Service → Template → copie as IDs abaixo
# Usado por: Desafio da Semana, Casos de Uso e Pedidos de Criação Similar
# Deixe em branco para simular envio sem de fato disparar e-mail
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Google Sheets via Apps Script — registro de formulários em planilha
# Setup: crie um Apps Script com doPost(e), publique como Web App e cole a URL abaixo
# Deixe em branco para desativar o registro na planilha (EmailJS ainda funciona normalmente)
VITE_SHEETS_WEBHOOK_URL=
