rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Criações do portal (galeria pública) ─────────────────
    match /creations/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Inscrições do Prêmio IA ──────────────────────────────
    match /premioInscricoes/{docId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // ── Comunicados (banners home) ───────────────────────────
    match /comunicados/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Restante da base (admin only) ────────────────────────
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
